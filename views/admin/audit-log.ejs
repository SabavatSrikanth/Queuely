<%- include('../layouts/main', { title: 'Audit Logs - ' + appName, body: ` <div
  class="d-flex justify-content-between align-items-center mb-4">
  <h2 class="fw-bold m-0">Platform Audit Logs</h2>
  <a href="/admin" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back to Dashboard</a>
  </div>

  <div class="row g-2 mb-3">
    <div class="col-md-3">
      <select id="filter-resource" class="form-select">
        <option value="">All resources</option>
        <option value="User">User</option>
        <option value="Business">Business</option>
      </select>
    </div>
    <div class="col-md-3">
      <select id="filter-severity" class="form-select">
        <option value="">All severities</option>
        <option value="info">Info</option>
        <option value="warning">Warning</option>
        <option value="critical">Critical</option>
      </select>
    </div>
  </div>

  <div class="card shadow-sm border-0">
    <div class="card-body">
      <div class="table-responsive">
        <table class="table table-hover align-middle">
          <thead class="table-light">
            <tr>
              <th>Timestamp</th>
              <th>Actor</th>
              <th>Action</th>
              <th>Resource</th>
              <th>Severity</th>
              <th>IP</th>
            </tr>
          </thead>
          <tbody id="audit-list">
            <tr>
              <td colspan="6" class="text-center text-muted py-4">Loading logs...</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  `, script: `
  <script>
    function esc(str) {
      if (str === null || str === undefined) return '';
      const d = document.createElement('div');
      d.textContent = String(str);
      return d.innerHTML;
    }

    const severityClass = { info: 'secondary', warning: 'warning', critical: 'danger' };

    function loadLogs() {
      const resource = document.getElementById('filter-resource').value;
      const severity = document.getElementById('filter-severity').value;
      let url = '/api/admin/audit-logs?';
      if (resource) url += 'resource=' + resource + '&';
      if (severity) url += 'severity=' + severity;

      fetch(url)
        .then(function (res) {
          if (res.status === 403 || res.status === 401) { window.location.href = '/login'; return null; }
          return res.json();
        })
        .then(function (data) {
          if (!data) return;
          const list = document.getElementById('audit-list');
          if (!data.success || data.data.length === 0) {
            list.innerHTML = '<tr><td colspan="6" class="text-center text-muted">No audit logs found.</td></tr>';
            return;
          }
          list.innerHTML = data.data.map(function (log) {
            return '<tr>' +
              '<td><small>' + new Date(log.createdAt).toLocaleString() + '</small></td>' +
              '<td>' + esc(log.actorSnapshot ? log.actorSnapshot.name + ' (' + log.actorSnapshot.role + ')' : 'System') + '</td>' +
              '<td><span class="badge bg-secondary">' + esc(log.action) + '</span></td>' +
              '<td>' + esc(log.resource) + ' ' + (log.resourceId ? '<small class="text-muted">(' + esc(String(log.resourceId).slice(0, 8)) + '...)</small>' : '') + '</td>' +
              '<td><span class="badge bg-' + (severityClass[log.severity] || 'secondary') + '">' + esc(log.severity) + '</span></td>' +
              '<td><small class="text-muted">' + esc(log.meta && log.meta.ip ? log.meta.ip : '') + '</small></td>' +
              '</tr>';
          }).join('');
        });
    }

    document.getElementById('filter-resource').addEventListener('change', loadLogs);
    document.getElementById('filter-severity').addEventListener('change', loadLogs);

    loadLogs();
  </script>
  ` }) %>