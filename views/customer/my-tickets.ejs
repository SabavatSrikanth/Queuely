<%- include('../layouts/main', { title: 'My Tickets - ' + appName, body: `
  <h2 class="fw-bold mb-4">My Tickets</h2>
  <div class="row" id="ticket-list">
    <div class="col-12 text-muted">Loading tickets...</div>
  </div>
`, script: `
  <script>
    function esc(str) {
      if (str === null || str === undefined) return '';
      const div = document.createElement('div');
      div.textContent = String(str);
      return div.innerHTML;
    }

    fetch('/api/queue/my-tickets')
      .then(res => {
        if (res.status === 401) { window.location.href = '/login'; return null; }
        return res.json();
      })
      .then(data => {
        if (!data || !data.success) return;
        const list = document.getElementById('ticket-list');
        if (data.data.length === 0) {
          list.innerHTML = '<div class="col-12"><p class="text-muted">You have no tickets.</p></div>';
          return;
        }
        list.innerHTML = data.data.map(t => \`
          <div class="col-md-6 col-lg-4 mb-4">
            <div class="card shadow-sm border-0 h-100">
              <div class="card-body">
                <p class="text-muted mb-1">\${esc(t.business ? t.business.name : '')} — \${esc(t.service ? t.service.name : '')}</p>
                <div class="d-flex justify-content-between align-items-center mb-3">
                  <h1 class="display-5 fw-bold text-primary m-0">\${esc(t.ticketNumber)}</h1>
                  <span class="badge bg-\${t.status === 'waiting' ? 'warning' : t.status === 'called' || t.status === 'serving' ? 'success' : 'secondary'}">\${esc(t.status.toUpperCase())}</span>
                </div>
                <p class="text-muted mb-1"><small>Joined: \${new Date(t.createdAt).toLocaleString()}</small></p>
                \${['waiting', 'called', 'serving'].includes(t.status) ? \`<a href="/ticket-status/\${t._id}" class="btn btn-outline-primary w-100 mt-3">View Live Status</a>\` : ''}
              </div>
            </div>
          </div>
        \`).join('');
      });
  </script>
` }) %>
