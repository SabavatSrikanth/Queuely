<%- include('../layouts/main', { title: 'My Tickets - ' + appName, body: ` <h2 class="fw-bold mb-4">My Tickets</h2>
  <div class="row" id="ticket-list">
    <div class="col-12 text-muted">Loading tickets...</div>
  </div>
  `, script: `
  <script>
    function esc(str) {
      if (str === null || str === undefined) return '';
      var d = document.createElement('div');
      d.textContent = String(str);
      return d.innerHTML;
    }
    var socket = io();

    function makeCard(t) {
      var statusColor = t.status === 'waiting' ? 'warning' : (t.status === 'called' || t.status === 'serving') ? 'success' : 'secondary';
      var div = document.createElement('div');
      div.className = 'col-md-6 col-lg-4 mb-4';
      var inner = '<div class="card shadow-sm border-0 h-100"><div class="card-body">';
      inner += '<p class="text-muted mb-1">' + esc(t.business ? t.business.name : '') + ' - ' + esc(t.service ? t.service.name : '') + '</p>';
      inner += '<div class="d-flex justify-content-between align-items-center mb-3">';
      inner += '<h1 class="display-5 fw-bold text-primary m-0">' + esc(t.ticketNumber) + '</h1>';
      inner += '<span class="badge bg-' + statusColor + '">' + esc(t.status.toUpperCase()) + '</span>';
      inner += '</div>';
      inner += '<p class="text-muted mb-1"><small>Joined: ' + new Date(t.createdAt).toLocaleString() + '</small></p>';
      if (['waiting', 'called', 'serving'].indexOf(t.status) !== -1) {
        inner += '<a href="/ticket-status/' + t._id + '" class="btn btn-outline-primary w-100 mt-3">View Live Status</a>';
      }
      if (t.status === 'waiting') {
        inner += '<button class="btn btn-outline-danger w-100 mt-2" data-cancel-id="' + t._id + '">Cancel Ticket</button>';
      }
      inner += '</div></div>';
      div.innerHTML = inner;
      return div;
    }

    function loadTickets() {
      fetch('/api/queue/my-tickets', { credentials: 'include' })
        .then(function (res) {
          if (res.status === 401) { window.location.href = '/login'; return null; }
          return res.json();
        })
        .then(function (data) {
          if (!data || !data.success) return;
          var list = document.getElementById('ticket-list');
          list.innerHTML = '';
          if (data.data.length === 0) {
            list.innerHTML = '<div class="col-12"><p class="text-muted">You have no tickets.</p></div>';
            return;
          }
          data.data.forEach(function (t) {
            var card = makeCard(t);
            list.appendChild(card);
            if (['waiting', 'called', 'serving'].indexOf(t.status) !== -1) {
              socket.emit('join:ticket_room', { ticketId: t._id });
            }
            var cancelBtn = card.querySelector('[data-cancel-id]');
            if (cancelBtn) {
              cancelBtn.addEventListener('click', function () {
                cancelTicket(this.getAttribute('data-cancel-id'));
              });
            }
          });
        });
    }

    function cancelTicket(id) {
      var reason = prompt('Select reason: 1=Too long wait, 2=Change of plans, 3=Personal emergency, 4=Booked by mistake, 5=Other. Enter number:');
      if (!reason) return;
      var reasons = ['Too long wait', 'Change of plans', 'Personal emergency', 'Booked by mistake', 'Other'];
      var index = parseInt(reason) - 1;
      var selectedReason = (index >= 0 && index < reasons.length) ? reasons[index] : 'Other';
      fetch('/api/queue/cancel/' + id, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify({ reason: selectedReason })
      }).then(function () {
        loadTickets();
        showToast('Ticket cancelled!', 'warning');
      });
    }

    socket.on('ticket:status_update', function () { loadTickets(); });
    socket.on('queue:live_update', function () { loadTickets(); });

    loadTickets();
  </script>
  ` }) %>