<%- include('../layouts/main', { title: 'Business Profile - ' + appName, user: typeof user !== 'undefined' ? user : null, body: `
  <div class="mb-4">
    <a href="/" class="text-decoration-none"><i class="bi bi-arrow-left"></i> Back to Home</a>
  </div>
  <div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-5 text-center">
      <h2 class="fw-bold mb-2" id="biz-name">Loading...</h2>
      <p class="text-muted lead" id="biz-desc"></p>
      <div class="d-flex justify-content-center gap-3 mt-4">
        <span class="badge bg-primary px-3 py-2" id="biz-cat"></span>
        <span class="badge bg-success px-3 py-2"><i class="bi bi-star-fill"></i> <span id="biz-rating"></span></span>
      </div>
    </div>
  </div>

  <h4 class="fw-bold mb-3">Available Services</h4>
  <div class="row g-4" id="service-list">
    <div class="col-12 text-muted">Loading services...</div>
  </div>
`, script: `
  <script>
    const slug = '${slug}';
    let businessId = null;

    // Escapes dynamic, business/owner-controlled text (service & business
    // name/description) before it's inserted via innerHTML, since those
    // fields are set by business owners and rendered for every visitor —
    // without escaping, a malicious owner could store an XSS payload in a
    // service name/description that executes in every customer's browser.
    function esc(str) {
      if (str === null || str === undefined) return '';
      const div = document.createElement('div');
      div.textContent = String(str);
      return div.innerHTML;
    }

    fetch('/api/businesses/slug/' + encodeURIComponent(slug))
      .then(res => res.json())
      .then(data => {
        if (!data.success || !data.data) {
          document.getElementById('biz-name').innerText = 'Business not found';
          document.getElementById('service-list').innerHTML = '';
          return null;
        }
        const biz = data.data;
        businessId = biz._id;
        document.getElementById('biz-name').innerText = biz.name;
        document.getElementById('biz-desc').innerText = biz.description || 'No description available.';
        document.getElementById('biz-cat').innerText = biz.category || '';
        document.getElementById('biz-rating').innerText = (biz.averageRating || 0).toFixed(1) + ' (' + (biz.totalReviews || 0) + ' reviews)';

        return fetch('/api/services?business=' + biz._id).then(r => r.json());
      })
      .then(data => {
        const list = document.getElementById('service-list');
        if (!data) return;
        if (!data.success || !data.data || data.data.length === 0) {
          list.innerHTML = '<div class="col-12"><p class="text-muted">No services found.</p></div>';
          return;
        }
        list.innerHTML = data.data.map(s => \`
          <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
              <div class="card-body">
                <h5 class="fw-bold">\${esc(s.name)}</h5>
                <p class="text-muted mb-3">\${esc(s.description || '')}</p>
                <div class="d-flex justify-content-between align-items-center mb-3">
                  <span class="badge bg-light text-dark border">Est. Duration: \${esc(s.estimatedServiceTime)}m</span>
                  <span class="badge \${s.isAcceptingQueue ? 'bg-success' : 'bg-danger'}">\${s.isAcceptingQueue ? 'Live Queue Open' : 'Queue Closed'}</span>
                </div>
                <div class="d-flex gap-2">
                  \${s.isAcceptingQueue && s.walkinEnabled ? \`<a href="/q/\${encodeURIComponent(slug)}/\${s._id}" class="btn btn-primary flex-grow-1">View Live Queue</a>\` : ''}
                  \${s.appointmentEnabled ? \`<a href="/my-appointments?book=\${s._id}" class="btn btn-outline-primary flex-grow-1">Book Appointment</a>\` : ''}
                </div>
              </div>
            </div>
          </div>
        \`).join('');
      })
      .catch(() => {
        document.getElementById('biz-name').innerText = 'Something went wrong loading this page.';
      });
  </script>
` }) %>
