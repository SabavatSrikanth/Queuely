<%- include('../layouts/main', { title: 'Forgot Password - ' + appName, body: `
  <div class="row justify-content-center">
    <div class="col-md-5">
      <div class="card shadow-sm border-0 mt-5">
        <div class="card-body p-4">
          <h3 class="text-center mb-4">Reset Password</h3>

          <div id="step-email">
            <p class="text-muted text-center mb-4">Enter your email address to begin.</p>
            <div id="emailMessageBox" class="alert d-none"></div>
            <div class="mb-3">
              <label class="form-label">Email address</label>
              <input type="email" class="form-control" id="email" required>
            </div>
            <button type="button" class="btn btn-primary w-100 py-2" id="btn-check-email">Continue</button>
          </div>

          <div id="step-question" style="display:none;">
            <p class="text-muted text-center mb-4">Answer your security question to reset your password.</p>
            <div id="questionMessageBox" class="alert d-none"></div>
            <div class="mb-3">
              <label class="form-label" id="question-text"></label>
              <input type="text" class="form-control" id="security-answer-input" placeholder="Your answer" required>
            </div>
            <div class="mb-3">
              <label class="form-label">New Password</label>
              <input type="password" class="form-control" id="new-password-input" placeholder="Min 8 characters" required minlength="8">
            </div>
            <button type="button" class="btn btn-primary w-100 py-2" id="btn-reset-with-answer">Reset Password</button>
          </div>

          <div id="step-no-question" style="display:none;">
            <div class="alert alert-warning">This account doesn't have a security question set up. Please contact support for help recovering your account.</div>
          </div>

          <div class="text-center mt-3">
            <a href="/login" class="text-decoration-none">Back to Login</a>
          </div>
        </div>
      </div>
    </div>
  </div>
`, script: `
  <script>
    var userEmail = '';

    function showMessage(boxId, message, type) {
      var box = document.getElementById(boxId);
      box.classList.remove('d-none', 'alert-success', 'alert-danger');
      box.classList.add('alert-' + type);
      box.textContent = message;
    }

    document.getElementById('btn-check-email').addEventListener('click', async function() {
      var email = document.getElementById('email').value.trim();
      if (!email) {
        showMessage('emailMessageBox', 'Please enter your email address.', 'danger');
        return;
      }
      userEmail = email;
      var btn = this;
      btn.disabled = true;
      btn.textContent = 'Checking...';

      try {
        var res = await fetch('/api/auth/security-question', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: email })
        });
        var data = await res.json();

        if (data.success && data.data.hasQuestion) {
          document.getElementById('step-email').style.display = 'none';
          document.getElementById('step-question').style.display = 'block';
          document.getElementById('question-text').textContent = data.data.question;
        } else {
          document.getElementById('step-email').style.display = 'none';
          document.getElementById('step-no-question').style.display = 'block';
        }
      } catch (err) {
        showMessage('emailMessageBox', 'Something went wrong. Please try again.', 'danger');
      } finally {
        btn.disabled = false;
        btn.textContent = 'Continue';
      }
    });

    document.getElementById('btn-reset-with-answer').addEventListener('click', async function() {
      var answer = document.getElementById('security-answer-input').value.trim();
      var newPassword = document.getElementById('new-password-input').value;

      if (!answer || !newPassword) {
        showMessage('questionMessageBox', 'Please fill in both fields.', 'danger');
        return;
      }
      if (newPassword.length < 8) {
        showMessage('questionMessageBox', 'Password must be at least 8 characters.', 'danger');
        return;
      }

      var btn = this;
      btn.disabled = true;
      btn.textContent = 'Resetting...';

      try {
        var res = await fetch('/api/auth/reset-with-security-answer', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({ email: userEmail, answer: answer, newPassword: newPassword })
        });
        var data = await res.json();

        if (data.success) {
          showMessage('questionMessageBox', 'Password reset successfully! Redirecting...', 'success');
          setTimeout(function() { window.location.href = '/'; }, 1500);
        } else {
          showMessage('questionMessageBox', data.error || data.message || 'Incorrect answer. Please try again.', 'danger');
          btn.disabled = false;
          btn.textContent = 'Reset Password';
        }
      } catch (err) {
        showMessage('questionMessageBox', 'Something went wrong. Please try again.', 'danger');
        btn.disabled = false;
        btn.textContent = 'Reset Password';
      }
    });
  </script>
` }) %>